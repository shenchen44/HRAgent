# 虚拟环境：906MB，绝不能进仓库
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node（scripts/smoke_ui.mjs 的可选依赖）
node_modules/
package-lock.json

# SQLite 运行时产物：-wal/-shm 是瞬时文件，不该提交。
